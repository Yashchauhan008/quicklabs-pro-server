# Server Configuration
NODE_ENV=development
PORT=5000
HOST=localhost

# Database Configuration
DB_HOST=localhost
DB_PORT=5432
DB_NAME=quicklabs_pro
DB_USER=postgres
DB_PASSWORD=

# Database URL for dbmate
DATABASE_URL=postgres://postgres:password@localhost:5432/quicklabs_pro?sslmode=disable

# JWT Configuration
JWT_SECRET=
JWT_EXPIRES_IN=7d
JWT_REFRESH_SECRET=
JWT_REFRESH_EXPIRES_IN=30d

# Google OAuth Configuration
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# CORS Configuration
CORS_ORIGIN=http://localhost:3000

# Rate Limiting
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX_REQUESTS=100

# Logging
LOG_LEVEL=debug
LOG_FILE=logs/app.log

# Student quotas (optional; defaults shown)
MAX_SUBJECTS_PER_STUDENT=2
MAX_UPLOADS_PER_DAY_STUDENT=10
# 0 = unlimited student downloads per day; set a positive number to enforce a cap
MAX_DOWNLOADS_PER_DAY=0
